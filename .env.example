# Supabase Configuration (Client-side)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEYS=sb_publishable_your_publishable_key_here

# Supabase Configuration (Server-side only — do NOT prefix with VITE_)
# Edge Functions & Cloudflare Pages Functions use JSON format:
# Set as secrets in Supabase Edge Functions dashboard and Cloudflare Pages environment variables:
# SUPABASE_SECRET_KEYS={"default":"sb_secret_your_secret_key_here"}
# SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_your_publishable_key_here"}

# Note: SUPABASE_SECRET_KEYS is for server-side use only (Edge Functions, Cloudflare Pages Functions)

# Resend Email Service (configured in Cloudflare environment variables)
# Set RESEND_API_KEY in Cloudflare Pages dashboard
# Functions will access this to send emails via /api/send-campaign-email

# Cloudflare R2 Storage (Optional - for image hosting)
VITE_R2_ACCOUNT_ID=your_r2_account_id
VITE_R2_ACCESS_KEY_ID=your_r2_access_key
VITE_R2_SECRET_ACCESS_KEY=your_r2_secret_key
VITE_R2_BUCKET_NAME=your_bucket_name
VITE_R2_PUBLIC_URL=https://your-public-url.r2.dev

# Razorpay Payment Gateway
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
VITE_RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Analytics 4 (GA4)
# Get your Measurement ID from https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Tawk.to Live Chat
# Get your Property ID from https://www.tawk.to
# Dashboard > Administration > Property
# Format: 64-character hexadecimal string
VITE_TAWK_PROPERTY_ID=your_tawk_property_id

# Base URL (for production)
# Used for canonical URLs, sitemaps, and Open Graph tags
VITE_BASE_URL=https://nirchal.com

# Environment
NODE_ENV=development

